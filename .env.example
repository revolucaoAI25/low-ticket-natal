# Endereço público do site (sem barra no final)
NEXT_PUBLIC_SITE_URL=https://seu-dominio.com.br

# Links de checkout da Kiwify
NEXT_PUBLIC_CHECKOUT_ESSENCIAL=
NEXT_PUBLIC_CHECKOUT_COMPLETO=

# ID do Pixel da Meta (só os números)
NEXT_PUBLIC_META_PIXEL_ID=

# Script de UTMs da Utmify (1 = ligado, 0 = desligado)
NEXT_PUBLIC_UTMIFY_UTMS=1

# Pop-up de saída: checkout do Plano Completo por R$ 19,90 (oferta especial na Kiwify)
NEXT_PUBLIC_CHECKOUT_SAIDA=

# Utmify: ID do pixel (opcional, o que a Utmify mostra em Pixels)
NEXT_PUBLIC_UTMIFY_PIXEL_ID=
# Utmify: token de API (Integrações > Credenciais de API). Usado só para os order bumps
UTMIFY_API_TOKEN=
# 1 = manda os pedidos para a Utmify como teste
UTMIFY_TEST=0

# E-mail de suporte que aparece na página e nos e-mails
NEXT_PUBLIC_SUPORTE_EMAIL=suporte@kitspravender.com.br

# Entrega por e-mail (Resend). O domínio do remetente precisa estar verificado no Resend
RESEND_API_KEY=
EMAIL_FROM=Kits pra Vender <entrega@kitspravender.com.br>

# Token do webhook da Kiwify. Um webhook por produto: separe os tokens por vírgula
KIWIFY_WEBHOOK_TOKEN=
